<div class="auth-page">

  <section class="auth-brand">

    <div class="brand-content">

      <div class="logo-area">

        <div class="logo-symbol">
          SIGE
        </div>

        <div class="logo-name">
          IFCE
        </div>

      </div>

      <h1>
        Sistema de Gerenciamento de
        Eventos do IFCE
      </h1>

    </div>

    <div class="brand-decoration">
      <span></span>
      <span></span>
    </div>

  </section>

  <section class="auth-form-area">

    <div class="auth-card">

      <h2>
        Acesse sua conta
      </h2>

      <p class="auth-description">
        Entre com seu e-mail e senha para continuar
      </p>

      <form id="login-form">

        <div class="field">

          <label for="email">
            E-mail
          </label>

          <input
            id="email"
            name="email"
            type="email"
            placeholder="Digite seu e-mail"
            autocomplete="email"
            required
          >

        </div>

        <div class="field">

          <label for="password">
            Senha
          </label>

          <input
            id="password"
            name="password"
            type="password"
            placeholder="Digite sua senha"
            autocomplete="current-password"
            required
          >

        </div>

        <a
          href="#"
          class="forgot-password"
          onclick="return false;"
        >
          Esqueceu sua senha?
        </a>

        <button
          type="submit"
          class="primary-button"
        >
          Entrar
        </button>

        <p class="auth-footer">
          Não tem uma conta?
          <a href="/cadastro">
            Cadastre-se
          </a>
        </p>

        <div
          id="login-message"
          class="form-message"
        ></div>

      </form>

    </div>

  </section>

</div>
