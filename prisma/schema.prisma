generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ORGANIZADOR
  PROFESSOR
  ALUNO
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  password String
  role     UserRole?
}
