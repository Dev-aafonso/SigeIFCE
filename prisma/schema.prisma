generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ORGANIZADOR
  PROFESSOR
  ALUNO
}

enum EventStatus {
  RASCUNHO
  PUBLICADO
  EM_ANDAMENTO
  ENCERRADO
  CANCELADO
}

enum ActionStatus {
  ATIVA
  ENCERRADA
  CANCELADA
}

model User {
  id       String   @id @default(cuid())
  name     String   @default("UsuÃƒÂ¡rio")
  email    String   @unique
  password String
  role     UserRole @default(ALUNO)
  sessionVersion Int @default(0)
  isActive Boolean @default(true)
  lastAccessAt DateTime?
  enrollmentNumber String?
  course String?
  campus String?

  events        Event[]
  registrations Registration[]
  certificates  Certificate[]
  notificationReads NotificationRead[]
}

model Event {
  id                   String      @id @default(cuid())
  title                String
  description          String
  startDate            DateTime
  endDate              DateTime
  location             String?
  category             String?
  workloadMinutes      Int?
  registrationStartDate DateTime?
  registrationEndDate   DateTime?
  totalCapacity        Int?
  status               EventStatus @default(RASCUNHO)
  minAttendancePercent Int         @default(75)
  publishedAt          DateTime?
  canceledAt           DateTime?
  closedAt             DateTime?
  organizerId          String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  scans        ScannedReport[]
  cover        EventCover?
  organizer    User          @relation(fields: [organizerId], references: [id])
  actions      Action[]
  certificates Certificate[]

  @@index([organizerId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([title])
}

model EventCover {
  eventId String @id
  mimeType String
  data Bytes
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Action {
  id              String       @id @default(cuid())
  eventId         String
  title           String
  description     String
  startDate       DateTime
  endDate         DateTime
  durationMinutes Int
  capacity        Int
  location        String?
  status          ActionStatus @default(ATIVA)
  canceledAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
  certificates  Certificate[]

  @@index([eventId])
  @@index([status])
  @@index([startDate])
}

enum RegistrationStatus {
  ACTIVE
  CANCELLED
}

model Registration {
  id          String             @id @default(cuid())
  userId      String
  actionId    String
  status      RegistrationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  cancelledAt DateTime?

  user        User         @relation(fields: [userId], references: [id])
  action      Action       @relation(fields: [actionId], references: [id])
  presence    Presence?    @relation("RegistrationPresence")
  certificate Certificate?

  @@unique([userId, actionId])
  @@index([actionId, status])
  @@index([userId, status])
}

model Presence {
  id             String   @id @default(cuid())
  registrationId String   @unique
  responsibleId  String
  registeredAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  registration Registration @relation("RegistrationPresence", fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([responsibleId])
  @@index([registeredAt])
}

model Certificate {
  scope             String   @default("ACTION")
  id                String   @id @default(cuid())
  userId            String
  eventId           String
  validationCode    String   @unique
  certifiedMinutes  Int
  attendancePercent Float
  issuedAt          DateTime @default(now())
  filePath          String

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actionId       String?
  registrationId String?       @unique
  revokedAt      DateTime?
  action         Action?       @relation(fields: [actionId], references: [id], onDelete: Restrict)
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: Restrict)

  @@unique([userId, actionId])
  @@index([eventId])
  @@index([userId])
  @@index([actionId])
  @@index([scope, eventId])
}

// Marcação de leitura para avisos derivados do histórico do próprio usuário.
model NotificationRead {
  userId String
  key String
  readAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, key])
}

model ScannedReport {
  id String @id @default(cuid())
  eventId String?
  authorId String
  text String
  createdAt DateTime @default(now())
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@index([eventId])
}
