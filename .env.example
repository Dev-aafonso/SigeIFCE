# SIGE IFCE - modelo de ambiente
# Ajuste os valores de exemplo antes de utilizar.

NODE_ENV=development
PORT=3000
APP_PORT=3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-hex-password
POSTGRES_DB=sige_ifce
POSTGRES_PORT=5433

# Ao executar a aplicacao diretamente no computador, use a porta publicada.
# A senha desta URL deve corresponder a POSTGRES_PASSWORD.
DATABASE_URL=postgresql://postgres:replace-with-a-random-hex-password@localhost:5433/sige_ifce?schema=public

# Gere um segredo novo localmente. Nunca reutilize este texto de exemplo.
JWT_SECRET=replace-with-a-random-secret

MOCK_MODE=false
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

IFCE_CAMPUS_NAME=Instituto Federal do Ceara - Campus Cedro
IFCE_LOGO_PATH=assets/ifce-logo-horizontal.png

# Caminhos opcionais para fontes personalizadas:
# CERTIFICATE_FONT_PATH=
# CERTIFICATE_FONT_BOLD_PATH=
# Local HTTP only. For production, use HTTPS and COOKIE_SECURE=true.
COOKIE_SECURE=false
